{
  "permissions": {"allow": ["Bash(uv run:*)"], "deny": ["Read(.env)"]},
  "model": "claude-opus-4.5",
  "includeCoAuthoredBy": false,
  "env": {"FOO": "bar"},
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh", "timeout": 10}]},
      {"matcher": "Edit|Write", "hooks": [{"type": "command", "command": "echo edit"}]}
    ],
    "SessionStart": [
      {"matcher": "startup", "hooks": [{"type": "command", "command": "echo hi"}, {"type": "prompt", "prompt": "summarise"}]}
    ],
    "Stop": [{"hooks": [{"type": "command", "command": "echo done"}]}],
    "TeammateIdle": [{"hooks": [{"type": "command", "command": "echo idle"}]}]
  }
}
